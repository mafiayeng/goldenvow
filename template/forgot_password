{% extends "base.html" %}
{% block title %}Forgot Password{% endblock %}
{% block content %}
<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="glass-card p-4">
            <h4 class="golden-text text-center">🔑 Reset Password</h4>
            <p class="text-muted-light text-center">Enter your email address and we'll send you a reset link.</p>
            <form method="POST">
                <div class="mb-3">
                    <input type="email" name="email" class="form-control bg-dark text-light" placeholder="Email" required>
                </div>
                <button type="submit" class="btn btn-gold w-100">Send Reset Link</button>
            </form>
            <div class="mt-3 text-center">
                <a href="{{ url_for('login') }}" class="text-muted-light">← Back to Login</a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
